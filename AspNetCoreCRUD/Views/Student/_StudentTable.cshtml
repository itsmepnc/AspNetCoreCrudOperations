@model List<AspNetCoreCRUD.Models.ViewModels.StudentRegistrationDto>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>DOB</th>
            <th>Gender</th>
            <th>Fee</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>@student.Dob.ToString("dd-MM-yyyy")</td>
                <td>@student.Gender</td>
                <td>@student.Fee</td>
                <td>
                    <a asp-action="EditStudent" asp-route-id="@student.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="ViewStudent" asp-route-id="@student.Id" class="btn btn-info btn-sm">View</a>
                    <a asp-action="RemoveStudent" asp-route-id="@student.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
